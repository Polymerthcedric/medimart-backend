# Database credentials for the development database.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Optional admin gate: when unset, /api/add_product and /api/delete_product
# are disabled (503). Clients send this value in the X-Admin-Token header.
ADMIN_API_TOKEN=

# Comma-separated browser origins allowed by CORS (default: localhost only).
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Demo callback check: when unset, /api/mpesa_callback returns 503. Include
# ?secret=<this value> in MPESA_CALLBACK_URL. This is NOT Safaricom's signature.
CALLBACK_SECRET=

# This prototype rejects non-sandbox API hosts. Production payments need a
# separate review, server-side order pricing, and authenticated callbacks.
MPESA_API_BASE=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORT_CODE=174379
MPESA_CALLBACK_URL=
